{
  "name": "sahib",
  "version": "0.2.2",
  "private": true,
  "description": "Sahib shared web application and Windows desktop host",
  "scripts": {
    "verify": "node tools/verify-release.mjs",
    "desktop:prepare": "node tools/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles nsis -- --locked",
    "desktop:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "predesktop:test": "node tools/prepare-desktop.mjs",
    "desktop:acceptance": "node tools/desktop-acceptance.mjs",
    "desktop:checksum": "node tools/desktop-checksum.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
